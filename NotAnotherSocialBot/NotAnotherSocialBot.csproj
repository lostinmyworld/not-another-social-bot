<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="packages.Social.Oversharers" Version="3.2.1" />
  </ItemGroup>

  <Target Name="CopyEnvLocal" AfterTargets="Build" Condition="Exists('.env.local')">
    <Copy SourceFiles=".env.local" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
