# Copy this, fill it in, and paste it as the repository secret ACCOUNT_<NAME>.
# Leave a value empty (or set the flag to false) for a platform the account doesn't use.

# State: where this account's shared posts are remembered. Use a file name unique to the account.
GIST_ID=
GIST_TOKEN=
GIST_STATE_FILE_NAME=

# YouTube
WATCHER_YOUTUBE_ENABLED=false
YOUTUBE_CHANNEL_ID=
YOUTUBE_API_KEY=
DISCORD_WEBHOOK_YOUTUBE=

# Instagram
WATCHER_INSTAGRAM_ENABLED=false
IG_ACCESS_TOKEN=
DISCORD_WEBHOOK_INSTAGRAM=

# Threads: every shared YouTube and Instagram post is also posted to this Threads profile.
THREADS_ACCESS_TOKEN=

# Publishers
PUBLISHER_DISCORD_ENABLED=true
PUBLISHER_THREADS_ENABLED=false
